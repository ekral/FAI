    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "int pole[] = {0,6,24,53,88,128,167,202,231,249,255,249,231,202,167,128,88,53,24,6};\nint delka = sizeof(pole) / sizeof(int);\n\nint i = 0;\n\nvoid setup() \n{\n  pinMode(11, OUTPUT);\n  analogWrite(11, 0);\n}\n\nvoid loop() \n{\n  int intensity = pole[i];\n  analogWrite(11, intensity);\n\n  i = (i + 1) % delka;    \n\n  delay(50);\n}\n\n//  0 % 20 =  0 - 0 * 20 =  0\n// 19 % 20 = 19 - 0 * 20 = 19\n// 20 % 20 = 20 - 1 * 20 =  0"
      }
    ]
  },

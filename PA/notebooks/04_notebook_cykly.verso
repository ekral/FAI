    {
      "id": "526ba252-6d25-4ef7-9985-91f4c108c4cd",
      "type": "markdown",
      "source": "## Ukon\u010Den\u00ED vno\u0159en\u00E9ho cyklu for\n\nVno\u0159en\u00FD cyklus m\u016F\u017Eeme ukon\u010Dit pomoc\u00ED p\u0159\u00EDkazu \u0060goto\u0060, p\u0159\u00EDkazu \u0060return\u0060 nebo pomoc\u00ED pomocn\u00E9 prom\u011Bnn\u00E9."
    },
    {
      "id": "3bae07ab-e4e1-4888-bfb3-740ec6ab4ed2",
      "type": "code",
      "language": "csharp",
      "source": "for (int i = 0; i \u003C 10; i\u002B\u002B)\n{\n    for(int j = 0; j \u003C 10; j\u002B\u002B)\n    {\n        if (i == 1 \u0026\u0026 j == 3)\n        {\n            goto label;\n        }\n\n        Console.WriteLine($\u0022i = {i}, j = {j}\u0022);\n    }\n}\n\nlabel:\nConsole.WriteLine(\u0022konec vno\u0159en\u00E9ho cyklu\u0022);",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "i = 0, j = 0\ni = 0, j = 1\ni = 0, j = 2\ni = 0, j = 3\ni = 0, j = 4\ni = 0, j = 5\ni = 0, j = 6\ni = 0, j = 7\ni = 0, j = 8\ni = 0, j = 9\ni = 1, j = 0\ni = 1, j = 1\ni = 1, j = 2\nkonec vno\u0159en\u00E9ho cyklu\n",
          "channel": "stdout"
        }
      ],
      "metadata": {
        "execution_count": 7
      }
    },
    {
      "id": "a132571a-04cf-4864-9c1a-ca009da6e9b1",
      "type": "code",
      "language": "csharp",
      "source": "for (int i = 0; i \u003C 10; i\u002B\u002B)\n{\n    for(int j = 0; j \u003C 10; j\u002B\u002B)\n    {\n        if (i == 1 \u0026\u0026 j == 3)\n        {\n            return; // ukonci metodu\n        }\n\n        Console.WriteLine($\u0022i = {i}, j = {j}\u0022);\n    }\n}",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "i = 0, j = 0\ni = 0, j = 1\ni = 0, j = 2\ni = 0, j = 3\ni = 0, j = 4\ni = 0, j = 5\ni = 0, j = 6\ni = 0, j = 7\ni = 0, j = 8\ni = 0, j = 9\ni = 1, j = 0\ni = 1, j = 1\ni = 1, j = 2\n",
          "channel": "stdout"
        },
        {
          "mimeType": "text/html",

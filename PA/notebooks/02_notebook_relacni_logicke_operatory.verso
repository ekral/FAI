      "type": "code",
      "language": "csharp",
      "source": "double t1 = 30.0;\ndouble t2 = 40.0;\ndouble t3 = 70.0;\n\nConsole.WriteLine($\u0022test 1: {t1}, test 2: {t2}, test 3: {t3}\u0022);"
    },
